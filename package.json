{
  "name": "adaptive-labs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "npm run build:shared && npm run build:api:only",
    "build:shared": "npm run build:contracts && npm run build:domain && npm run build:db",
    "build:contracts": "npm run build --workspace @adaptive-labs/contracts",
    "build:domain": "npm run build --workspace @adaptive-labs/domain",
    "build:db": "npm run build --workspace @adaptive-labs/db",
    "build:api:only": "npm run build:only --workspace @adaptive-labs/api",
    "gcp-build": "npm run build",
    "typecheck": "npm run build && npm run typecheck --workspaces",
    "test": "npm run build && node --test services/api/dist/test/*.test.js",
    "start": "node --env-file-if-exists=.env services/api/dist/src/server.js",
    "db:migrate": "npm run build && node --env-file-if-exists=.env services/api/dist/src/migrate.js",
    "db:check": "npm run build && node --env-file-if-exists=.env services/api/dist/src/check-database.js",
    "local:configure": "node scripts/init-local-env.mjs",
    "test:db": "npm run build && node --env-file-if-exists=.env --test packages/db/test/*.test.mjs",
    "mobile:start": "node --env-file-if-exists=.env node_modules/expo/bin/cli start apps/mobile",
    "mobile:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-android.ps1",
    "mobile:typecheck": "npm run typecheck --workspace @adaptive-labs/mobile",
    "mobile:test": "node --experimental-strip-types --test apps/mobile/test/*.test.ts",
    "web:dev": "npm run dev --workspace @adaptive-labs/web",
    "web:typecheck": "npm run typecheck --workspace @adaptive-labs/web",
    "web:test": "npm run test --workspace @adaptive-labs/web",
    "web:build": "npm run build --workspace @adaptive-labs/contracts && npm run build --workspace @adaptive-labs/web"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
