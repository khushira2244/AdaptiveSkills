{
  "expo": {
    "name": "AdaptiveSkills",
    "slug": "adaptive-skills",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.adaptivelabs.adaptiveskills",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.adaptivelabs.adaptiveskills"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-document-picker",
      "expo-localization",
      "./plugins/withIosOrientation.cjs"
    ],
    "extra": {
      "eas": {
        "projectId": "6dfaa7a5-4f9c-489a-a17c-cdafee1972f6"
      }
    },
    "owner": "adaptive-labs"
  }
}
