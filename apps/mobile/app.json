{
  "expo": {
    "name": "AdaptiveSkills",
    "slug": "adaptive-skills",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adaptivelabs.adaptiveskills"
    },
    "android": {
      "package": "com.adaptivelabs.adaptiveskills",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "6dfaa7a5-4f9c-489a-a17c-cdafee1972f6"
      }
    },
    "owner": "adaptive-labs"
  }
}
