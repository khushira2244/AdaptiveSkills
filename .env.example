# Copy to .env and replace placeholders. Never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API. Use exact HTTPS
# Vercel domains in production; do not use a wildcard with authenticated APIs.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Docker local PostgreSQL. Use a randomly generated hexadecimal password.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql://adaptive_labs:REPLACE_WITH_RANDOM_HEX@127.0.0.1:5432/adaptive_labs
# Generate a separate random secret (at least 32 characters).
AUTH_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET
RESUME_STORAGE_DIR=.data/resumes

# Mobile-safe public configuration. Set API_URL to the deployed HTTPS API.
# The RevenueCat Test Store SDK key is public by design; never use a secret key here.
EXPO_PUBLIC_API_URL=https://REPLACE_WITH_DEPLOYED_API_HOST
EXPO_PUBLIC_REVENUECAT_API_KEY=REPLACE_WITH_REVENUECAT_TEST_STORE_PUBLIC_SDK_KEY

# RevenueCat server-only values. Never place these in the React Native bundle.
# Configure this exact value as the Authorization header in the RevenueCat webhook dashboard.
REVENUECAT_WEBHOOK_AUTH_TOKEN=REPLACE_WITH_LONG_RANDOM_WEBHOOK_TOKEN
# Secret RevenueCat API key used only for server-side entitlement reconciliation.
REVENUECAT_SECRET_API_KEY=REPLACE_WITH_REVENUECAT_SECRET_API_KEY
# Optional for a v2 secret key. Omit when using a legacy RevenueCat server key.
# REVENUECAT_PROJECT_ID=proj123abc
REVENUECAT_ENTITLEMENT_ID=adaptive_labs_pro
REVENUECAT_OFFERING_ID=default
REVENUECAT_CONTINUATION_OFFERING_ID=continuation
REVENUECAT_CONTINUATION_PACKAGE_ID=growth_runway
REVENUECAT_CONTINUATION_ENTITLEMENT_ID=adaptive_labs_growth
REVENUECAT_CONTINUATION_PRODUCT_ID=adaptive_labs_growth_799

# Server-only OpenAI reasoning. Never expose this through EXPO_PUBLIC_*.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_PROJECT_KEY
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_TIMEOUT_MS=90000
OPENAI_REASONING_MAX_RETRIES=1
